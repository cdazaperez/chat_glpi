# ============================================================================
# HELPDESK AI - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================================================

# ----------------------------------------------------------------------------
# GLPI CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------
# Base URL of your GLPI instance (without trailing slash)
GLPI_BASE_URL=https://helpdesk.example.com

# GLPI API Application Token (generated in GLPI: Setup > General > API)
GLPI_APP_TOKEN=

# GLPI User credentials for API authentication
GLPI_USERNAME=
GLPI_PASSWORD=

# Optional: GLPI session timeout in minutes (default: 30)
GLPI_SESSION_TIMEOUT_MINUTES=30

# Optional: Max retries for GLPI API calls (default: 3)
GLPI_MAX_RETRIES=3

# Optional: Timeout for GLPI API requests in seconds (default: 30)
GLPI_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------------------
# OPENAI CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------
# OpenAI API Key (required)
OPENAI_API_KEY=

# OpenAI Model to use (required)
# Examples: gpt-4.1-mini, gpt-4.1, gpt-4o, gpt-4o-mini
OPENAI_MODEL=gpt-4.1-mini

# Optional: Custom OpenAI API base URL (for proxies or Azure OpenAI)
# Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: OpenAI Organization ID
OPENAI_ORG_ID=

# Optional: OpenAI Project ID
OPENAI_PROJECT_ID=

# Temperature for responses (0.0 - 2.0, lower = more deterministic)
# Default: 0.2 (recommended for helpdesk to reduce hallucinations)
OPENAI_TEMPERATURE=0.2

# Maximum tokens for response generation
# Default: 800
OPENAI_MAX_TOKENS=800

# Timeout for OpenAI API requests in seconds
# Default: 60
OPENAI_TIMEOUT_SECONDS=60

# Number of retries for OpenAI API calls
# Default: 3
OPENAI_RETRIES=3

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------------------
# Environment: dev, staging, prod
APP_ENV=dev

# Port for the backend API server
APP_PORT=8000

# Log level: debug, info, warn, error
APP_LOG_LEVEL=info

# CORS allowed origins (comma-separated)
# Example: http://localhost:3000,https://helpdesk.example.com
APP_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit: requests per minute per IP/user
APP_RATE_LIMIT_RPM=30

# Session TTL in minutes
APP_SESSION_TTL_MINUTES=60

# Maximum message length (characters)
APP_MAX_MESSAGE_LENGTH=4000

# Application secret key for signing (generate with: openssl rand -hex 32)
APP_SECRET_KEY=

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION (OPTIONAL - for caching)
# ----------------------------------------------------------------------------
# Redis connection URL
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Cache TTL for KB search results (seconds)
REDIS_KB_CACHE_TTL=3600

# Cache TTL for ticket search results (seconds)
REDIS_TICKET_CACHE_TTL=900

# ----------------------------------------------------------------------------
# OBSERVABILITY (OPTIONAL)
# ----------------------------------------------------------------------------
# Enable OpenTelemetry tracing
OTEL_ENABLED=false

# OpenTelemetry exporter endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service name for tracing
OTEL_SERVICE_NAME=helpdesk-ai

# Enable Prometheus metrics endpoint
METRICS_ENABLED=true

# Metrics endpoint port (if different from APP_PORT)
METRICS_PORT=9090

# ----------------------------------------------------------------------------
# SECURITY (OPTIONAL)
# ----------------------------------------------------------------------------
# Enable JWT authentication
AUTH_ENABLED=false

# JWT secret key (generate with: openssl rand -hex 32)
AUTH_JWT_SECRET=

# JWT token expiry in minutes
AUTH_TOKEN_EXPIRY_MINUTES=60

# Allowed JWT issuers (comma-separated)
AUTH_JWT_ISSUERS=

# ----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ----------------------------------------------------------------------------
# Backend API URL (used by frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application title
NEXT_PUBLIC_APP_TITLE=Helpdesk AI

# Company name
NEXT_PUBLIC_COMPANY_NAME=SkillNet

# Enable debug mode in frontend
NEXT_PUBLIC_DEBUG=false
